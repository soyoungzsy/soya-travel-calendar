# Use only after mainland hosting/ICP requirements and TLS preparation are complete.
# Copy certificates separately on the server; never put private keys in Git.
server {
    listen 80;
    server_name scenicdue.com;
    return 301 https://scenicdue.com$request_uri;
}
server {
    listen 443 ssl;
    server_name scenicdue.com;
    ssl_certificate /etc/nginx/tls/scenicdue.com.pem;
    ssl_certificate_key /etc/nginx/tls/scenicdue.com.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 1m;
    access_log off;
    gzip on;
    gzip_min_length 1024;
    gzip_types text/css text/javascript application/javascript application/json image/svg+xml application/wasm;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_read_timeout 30s;
    }
}
