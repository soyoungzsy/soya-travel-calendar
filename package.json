{
  "name": "soya-travel-calendar",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "package:offline": "npm run build && node scripts/package-offline.mjs",
    "test": "node --test tests/*.test.mjs",
    "predev": "node scripts/prepare-ocr-assets.mjs",
    "prebuild": "node scripts/prepare-ocr-assets.mjs && node scripts/refresh-analytics-entities.mjs",
    "data:heritage": "node scripts/refresh-heritage-index.mjs",
    "data:cartography": "node scripts/prepare-cartography.mjs",
    "knowledge:check": "node scripts/check-knowledge.mjs",
    "start": "node server/node-server.mjs",
    "db:generate": "drizzle-kit generate --config=drizzle.config.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@tesseract.js-data/eng": "1.0.0",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tesseract.js": "7.0.0",
    "vite": "6.4.4",
    "d3-geo": "3.1.1",
    "topojson-client": "3.1.0"
  },
  "description": "A local-first travel calendar and personal destination list by Soya.",
  "license": "MIT",
  "author": "Soya",
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "topojson-server": "3.0.1",
    "topojson-simplify": "3.0.3",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2"
  },
  "homepage": "https://scenicdue.com/"
}
